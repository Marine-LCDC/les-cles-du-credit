# Variables d'environnement — Les Clés du Crédit
# Copier vers .env.local (ne jamais committer .env.local)

# Phase 3 — Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 3 — Stripe (mode test pour essais ; live en 3.8)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID régime 47 €/mois (Checkout + coupon intro)
STRIPE_PRICE_ID=
# Coupon −20 € répété 3 mois (id coup_…) — appliqué auto au Checkout si renseigné
STRIPE_COUPON_ID=

# Phase 3 — Brevo (3.6) — domaine authentifié SPF/DKIM en 3.8
BREVO_API_KEY=
# BREVO_SENDER_EMAIL=info@lesclesducredit.fr
# BREVO_SENDER_NAME=Les Clés du Crédit
